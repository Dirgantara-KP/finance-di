{
    "preset": "laravel",
    "rules": {
        "array_syntax": ["short"],
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        }
    },
    "exclude": [
        "vendor",
        "node_modules",
        "bootstrap/cache",
        "storage",
        "public/build",
        "database/database.sqlite"
    ]
}
